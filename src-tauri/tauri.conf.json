{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AppClear",
  "version": "1.0.0",
  "identifier": "cn.bit13.app.clear",
  "build": {
    "beforeDevCommand": "bash scripts/build-helper.sh debug && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && bash scripts/build-helper.sh release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AppClear",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 580,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
